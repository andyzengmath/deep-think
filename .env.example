# deep-think settings template.
#
# Copy this file to ~/.config/deep-think/.env (Windows:
# %USERPROFILE%\.config\deep-think\.env), or point DEEP_THINK_ENV_FILE at
# another private file. Uncomment the lines for the way you connect. Variables
# already set in your shell take precedence. Never commit the filled-in copy.
# Only AZURE_*, OPENAI_*, and DEEP_THINK_* variables are read from the file.

# Sign-in methods in priority order (optional). Later methods are backups:
#   entra       Azure OpenAI with Microsoft Entra ID (az login, managed identity)
#   azure-key   Azure OpenAI with an API key
#   openai-key  OpenAI API with an API key
# Leave unset to use one method detected from the settings below.
# DEEP_THINK_AUTH=entra,openai-key

# --- OpenAI API --------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1/
# Models tried after gpt-6-astra (comma-separated, or none).
# OPENAI_FALLBACK_MODELS=gpt-5.6-sol,gpt-5.4-pro

# --- Azure OpenAI --------------------------------------------------------------
# One resource that deploys gpt-6-astra (and, ideally, the fallback models):
# a v1 base URL, or a full preview /openai/responses?api-version=... URL.
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/openai/v1/
#
# Microsoft Entra ID needs no secret here: run `az login`, or use a managed or
# workload identity (set AZURE_CLIENT_ID for a user-assigned identity).
# For key authentication, or as a backup to Entra ID:
# AZURE_OPENAI_API_KEY=...
#
# Optional multi-resource backup plan. GPT-6 resources are tried first, then
# the fallback deployments (comma-separated, or none) on the fallback resource.
# Per-resource keys: AZURE_OPENAI_GPT6_API_KEY, AZURE_OPENAI_GPT6_BACKUP_API_KEY,
# and AZURE_OPENAI_FALLBACK_API_KEY.
# AZURE_OPENAI_GPT6_ENDPOINT=https://<gpt6-resource>.openai.azure.com/openai/v1/
# AZURE_OPENAI_GPT6_BACKUP_ENDPOINT=https://<gpt6-resource-2>.openai.azure.com/openai/v1/
# AZURE_OPENAI_GPT6_BACKUP_DEPLOYMENT=gpt-6-astra
# AZURE_OPENAI_FALLBACK_ENDPOINT=https://<resource>.openai.azure.com/openai/v1/
# AZURE_OPENAI_FALLBACK_DEPLOYMENTS=gpt-5.6-sol,gpt-5.4-pro
# Primary deployment name, if it is not gpt-6-astra.
# AZURE_OPENAI_DEPLOYMENT=gpt-6-astra

# --- Storage -------------------------------------------------------------------
# Where transcripts are written (default: ./deep-think-transcripts).
# DEEP_THINK_TRANSCRIPTS_ROOT=deep-think-transcripts
